NODE_ENV=development # or 'production'
PORT=5000 # or your desired port
HOST=your_host # '0.0.0.0' for localhost
APP_KEY=your_app_key
DRIVE_DISK=your_drive_disk # 'local' for localhost

CLOUDINARY_URL=your_cloudinary_url
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CLOUDINARY_FOLDER=your_cloudinary_folder

ORGANIZATION_OAUTH=false # Change to "true" if you want to enable OAuth login for a specific organization. Make sure to set the appropriate environment variables for the OAuth provider (e.g., Google, Facebook) when enabling this feature.
SECRET_KEY=your_secret_key
JWT_ISSUER=your_jwt_issuer
REDIS_URL=your_redis_url
HASH_DRIVER=your_hash_driver